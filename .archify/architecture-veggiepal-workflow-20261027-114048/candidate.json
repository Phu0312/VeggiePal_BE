  "cards": [
    {
      "dot": "cyan",
      "title": "Đọc bản đồ",
      "items": [
        "Mỗi service là một Maven project và ứng dụng Spring Boot độc lập.",
        "Cổng là mặc định cấu hình; bản đồ không khẳng định các tiến trình đang chạy.",
        "Đây là bản đồ định tuyến. Các lời gọi giữa service được giải thích trong bài hướng dẫn."
      ]
    },
    {
      "dot": "emerald",
      "title": "Dữ liệu thuộc về ai?",
      "items": [
        "7 service nghiệp vụ dùng 7 schema MySQL riêng; Gateway không quản lý dữ liệu nghiệp vụ.",
        "Cùng một máy MySQL vẫn có thể chứa nhiều schema. Không suy ra 7 máy database.",
        "DTO là dữ liệu API; entity là dữ liệu lưu; mapper chuyển đổi giữa chúng."
      ]
    },
    {
      "dot": "rose",
      "title": "Hai điểm dễ nhầm",
      "items": [
        "Spring Security ở service bảo vệ API; Gateway chủ yếu định tuyến và cấu hình CORS.",
        "AI còn nhận /ai/** trực tiếp qua Gateway mà không bỏ prefix; /api/ai/** thì bỏ /api.",
        "Nội dung sơ đồ bằng tiếng Việt; một số nút điều khiển Viewer có thể dùng tiếng Anh."
      ]
    }
  ]
